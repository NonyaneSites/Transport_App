# Supabase project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=

# Supabase public anonymous API key
VITE_SUPABASE_ANON_KEY=

# Google Apps Script Web App URL for automatic transport stats sync
VITE_GOOGLE_SHEETS_WEBHOOK_URL=

# Shared secret token for the Google Apps Script Web App deployment (optional)
VITE_GOOGLE_SHEETS_SECRET=

# Google Sheets tab name for transport stats (optional, defaults to "Stats")
VITE_GOOGLE_SHEETS_TAB_NAME=

# Master authorization code for the admin account approval portal (optional)
VITE_APPROVAL_SECRET=

# Confirmation password for resetting/clearing an active manifest session (optional)
VITE_RESET_PASSWORD=
